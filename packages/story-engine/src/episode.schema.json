{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commit-wars.dev/schema/episode-2.json",
  "title": "Commit Wars episode",
  "description": "Everything the player needs to run one repository's fight. Produced by @commit-wars/story-engine.",
  "type": "object",
  "required": [
    "schemaVersion",
    "summary",
    "chapters",
    "roster",
    "timeline"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "generatedAt": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "github-graphql",
            "github-rest",
            "git-log",
            "collection"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "commitLimit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "totalCommits": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "repo",
        "commits",
        "humans",
        "fixes",
        "first",
        "latest"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "repoUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "commits": {
          "type": "integer"
        },
        "humans": {
          "type": "integer"
        },
        "fixes": {
          "type": "integer"
        },
        "feats": {
          "type": "integer"
        },
        "reverts": {
          "type": "integer"
        },
        "refactors": {
          "type": "integer"
        },
        "botCommits": {
          "type": "integer"
        },
        "tags": {
          "type": "integer"
        },
        "issuesLinked": {
          "type": "integer"
        },
        "first": {
          "$ref": "#/$defs/moment"
        },
        "latest": {
          "$ref": "#/$defs/moment"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "first",
          "last",
          "commits",
          "fixes",
          "heroes",
          "powerups"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "sub": {
            "type": "string"
          },
          "first": {
            "$ref": "#/$defs/date"
          },
          "last": {
            "$ref": "#/$defs/date"
          },
          "commits": {
            "type": "integer"
          },
          "fixes": {
            "type": "integer"
          },
          "feats": {
            "type": "integer"
          },
          "reverts": {
            "type": "integer"
          },
          "refactors": {
            "type": "integer"
          },
          "enemyScope": {
            "type": [
              "string",
              "null"
            ]
          },
          "heroes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "commits",
                "fixes",
                "duel",
                "mob"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "commits": {
                  "type": "integer"
                },
                "fixes": {
                  "type": "integer"
                },
                "duel": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/fix"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "mob": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/fix"
                  }
                }
              }
            }
          },
          "powerups": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "who",
                "s",
                "d"
              ],
              "properties": {
                "who": {
                  "type": "string"
                },
                "s": {
                  "type": "string"
                },
                "d": {
                  "$ref": "#/$defs/date"
                },
                "files": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "sha": {
                  "type": "string"
                }
              }
            }
          },
          "revert": {
            "oneOf": [
              {
                "$ref": "#/$defs/moment"
              },
              {
                "type": "null"
              }
            ]
          },
          "boss": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "who",
                  "s",
                  "d",
                  "files"
                ],
                "properties": {
                  "who": {
                    "type": "string"
                  },
                  "s": {
                    "type": "string"
                  },
                  "d": {
                    "$ref": "#/$defs/date"
                  },
                  "files": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "sha": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "release": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "tag",
                  "d"
                ],
                "properties": {
                  "tag": {
                    "type": "string"
                  },
                  "d": {
                    "$ref": "#/$defs/date"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "roster": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "commits",
          "fixes",
          "first",
          "gauntlet"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "login": {
            "type": [
              "string",
              "null"
            ]
          },
          "avatarUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "commits": {
            "type": "integer"
          },
          "fixes": {
            "type": "integer"
          },
          "first": {
            "$ref": "#/$defs/date"
          },
          "areas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gauntlet": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/fix"
            }
          }
        }
      }
    },
    "timeline": {
      "$ref": "#/$defs/timeline"
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "moment": {
      "type": "object",
      "required": [
        "who",
        "s",
        "d"
      ],
      "properties": {
        "who": {
          "type": "string"
        },
        "s": {
          "type": "string"
        },
        "d": {
          "$ref": "#/$defs/date"
        },
        "sha": {
          "type": "string"
        }
      }
    },
    "fix": {
      "type": "object",
      "required": [
        "sha",
        "t",
        "s",
        "d",
        "type"
      ],
      "properties": {
        "sha": {
          "type": "string"
        },
        "pr": {
          "type": [
            "integer",
            "null"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "number",
              "title"
            ],
            "properties": {
              "number": {
                "type": "integer"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "t": {
          "type": "string"
        },
        "s": {
          "type": "string"
        },
        "sc": {
          "type": [
            "string",
            "null"
          ]
        },
        "d": {
          "$ref": "#/$defs/date"
        },
        "files": {
          "type": [
            "integer",
            "null"
          ]
        },
        "area": {
          "type": "string"
        },
        "type": {
          "enum": [
            "gremlin",
            "beetle",
            "crawler",
            "wraith",
            "moth",
            "bomb"
          ]
        }
      }
    },
    "timeline": {
      "type": "object",
      "description": "Every commit, for the movie player. Read it with the helpers in timeline.js.",
      "required": [
        "start",
        "end",
        "days",
        "people",
        "commits",
        "releases"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/date"
        },
        "end": {
          "$ref": "#/$defs/date"
        },
        "days": {
          "type": "integer",
          "minimum": 1,
          "description": "end - start + 1"
        },
        "people": {
          "type": "array",
          "description": "Everyone who committed, busiest first; the index is the person's id and picks their colour.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "bot",
              "commits"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "login": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "avatarUrl": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "bot": {
                "type": "boolean"
              },
              "commits": {
                "type": "integer"
              },
              "names": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "collection episodes: every name this person committed under"
              },
              "emails": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "collection episodes: every email this person committed under"
              }
            }
          }
        },
        "commits": {
          "type": "array",
          "description": "Sorted by day. [day, who, kind, files, type, sha, subject, pr, issues] plus repo in collection episodes",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0,
                "description": "days since start"
              },
              {
                "type": "integer",
                "minimum": 0,
                "description": "index into people"
              },
              {
                "enum": [
                  "fix",
                  "feat",
                  "refactor",
                  "revert",
                  "merge",
                  "other"
                ]
              },
              {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "files changed, null when unknown"
              },
              {
                "enum": [
                  "gremlin",
                  "beetle",
                  "crawler",
                  "wraith",
                  "moth",
                  "bomb",
                  null
                ],
                "description": "enemy type, fixes only"
              },
              {
                "type": "string",
                "description": "short sha"
              },
              {
                "type": "string",
                "description": "subject, clipped"
              },
              {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "pull request number"
              },
              {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "integer"
                },
                "description": "issues closed"
              },
              {
                "type": "integer",
                "minimum": 0,
                "description": "collection episodes: index into repos"
              }
            ],
            "minItems": 9,
            "maxItems": 10,
            "description": "9 slots for one repo; a 10th (repo index) in collection episodes"
          }
        },
        "releases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "tag",
              "day",
              "weight"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "day": {
                "type": "integer"
              },
              "weight": {
                "type": "integer"
              }
            }
          }
        },
        "repos": {
          "type": "array",
          "description": "Collection episodes only: the stories (repositories) combined, in order; a commit's 10th slot indexes this list.",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
